# Variable names only; never commit values. Set values per environment in
# Vercel, and locally in .env.local (git-ignored). See docs/04-architecture.md §9.3.
# Only NEXT_PUBLIC_SENTRY_DSN may use the NEXT_PUBLIC_ prefix.

# Supabase (server only; the browser never talks to Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only lib/supabase/service-role.ts, used by the AI route
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (model chosen by eval; never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# AI rate limiting: secret salt for the hashed IP, at least 32 characters
AI_RATE_LIMIT_SALT=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build time only, for source maps
SENTRY_AUTH_TOKEN=
